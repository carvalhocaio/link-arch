# Copy this file to .env.test and fill in your values.
# Bun automatically loads .env.test when running bun test (NODE_ENV=test).
# The local test script (bun run test:local) sources this file before starting Docker.
# Never commit .env.test — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# When using Docker (bun run test:local), these credentials match docker-compose.test.yml:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/link_arch_test"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Any random string works here for tests (functional tests mock auth anyway)
BETTER_AUTH_SECRET="test-secret-replace-with-openssl-rand-base64-32"

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3001"
