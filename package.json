{
  "name": "link-arch",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@link-arch/web",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "test": "turbo run test",
    "test:unit": "cd apps/web && bun test __tests__/unit",
    "test:local": "bash scripts/test-local.sh",
    "test:local:unit": "bash scripts/test-local.sh unit",
    "test:local:integration": "bash scripts/test-local.sh integration",
    "test:local:functional": "bash scripts/test-local.sh functional",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down --remove-orphans",
    "format": "biome format --write .",
    "db:generate": "turbo run db:generate --filter=@link-arch/db",
    "db:migrate": "turbo run db:migrate --filter=@link-arch/db"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "shadcn": "^4.11.0",
    "turbo": "^2.3.0"
  },
  "packageManager": "bun@1.2.0"
}
