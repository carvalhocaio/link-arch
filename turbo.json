{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**"],
			"env": [
				"DATABASE_URL",
				"BETTER_AUTH_SECRET",
				"GOOGLE_CLIENT_ID",
				"GOOGLE_CLIENT_SECRET",
				"FORWARD_TIMEOUT_MS",
				"NEXT_PUBLIC_APP_URL"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"check": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
			"env": [
				"DATABASE_URL",
				"NEXT_PUBLIC_APP_URL",
				"BETTER_AUTH_SECRET",
				"FORWARD_TIMEOUT_MS"
			]
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		}
	}
}
